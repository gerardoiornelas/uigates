import { view } from '../domain/board.mjs';
import { day } from '../domain/records.mjs';

export function run(board, { today, days }) {
  if (day(today) === null) throw Error('today must be YYYY-MM-DD');
  if (!Number.isInteger(days) || days < 0 || days > 365) {
    throw Error('days must be an integer from 0 to 365');
  }

  const start = Date.parse(today + 'T00:00:00Z');
  const end = start + days * 24 * 60 * 60 * 1000;
  return view(board)
    .filter(item => {
      if (item.state !== 'open' || !item.due) return false;
      const due = Date.parse(item.due + 'T00:00:00Z');
      return due >= start && due <= end;
    })
    .sort((a, b) => a.due < b.due ? -1 : a.due > b.due ? 1 : a.id - b.id);
}
