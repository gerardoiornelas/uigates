import { view } from '../domain/board.mjs';
import { day } from '../domain/records.mjs';

export function run(board, { today }) {
  const cutoff = day(today);
  if (cutoff === null) throw Error('today must be a nonempty YYYY-MM-DD date');

  return view(board)
    .filter(item => {
      const due = day(item.due);
      return item.state === 'open' && due !== null && due < cutoff;
    })
    .sort((a, b) => a.due < b.due ? -1 : a.due > b.due ? 1 : a.id - b.id);
}
